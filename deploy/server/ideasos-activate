#!/bin/bash
# Root activator for ideasos.io. Installed at /usr/local/sbin/ideasos-activate.
# Production runs it with no arguments:
#   sudo -n /usr/local/sbin/ideasos-activate
# CI runs the same file from stdin:
#   sudo -n bash -s -- --self-test < deploy/server/ideasos-activate
#
# It reads /var/www/ideasos.io/incoming/release.tar and release.tar.sha256,
# copies both with O_NOFOLLOW into a root-only temp dir, checks the hash,
# refuses link / absolute / .. members, and extracts to
# releases/<UTC timestamp>-<full git sha>. It chowns that tree to www-data
# (dirs 755, files 644), writes .deploy-sha, and atomically swaps a relative
# current symlink. A local Caddy check (curl --resolve to 127.0.0.1) must
# show the new index.html and index.json; otherwise the previous symlink
# is restored. The last 5 release directories are kept, plus current and
# the previous target. This program does not edit or reload the web server.
set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true

readonly SCRIPT_NAME="${BASH_SOURCE[0]:-$0}"
[[ -n "$SCRIPT_NAME" ]] || { echo "ideasos-activate: script name unset" >&2; exit 1; }

# Process-wide so the exit path can roll back a swap that did not finish.
CURRENT_WORK=""
SWAPPED=0
SUCCESS=0
ACTIVE_ROOT=""
PREV_TARGET=""

die() {
  echo "ideasos-activate: $*" >&2
  exit 1
}

restore_link() {
  local root="$1"
  local prev="$2"
  if [[ -L "${root}/current.new" ]]; then
    rm -f -- "${root}/current.new"
  elif [[ -e "${root}/current.new" ]]; then
    echo "ideasos-activate: current.new exists and is not a symlink" >&2
    return 1
  fi
  if [[ -z "$prev" ]]; then
    if [[ -L "${root}/current" ]]; then
      rm -f -- "${root}/current"
    fi
    return 0
  fi
  if [[ "$prev" == *$'\n'* ]]; then
    echo "ideasos-activate: previous target contains a newline" >&2
    return 1
  fi
  ln -s -- "$prev" "${root}/current.new"
  mv -T "${root}/current.new" "${root}/current"
  local now
  now=$(readlink -- "${root}/current")
  [[ "$now" == "$prev" ]]
}

on_exit() {
  local status=$?
  set +e
  if [[ "$SWAPPED" == 1 && "$SUCCESS" != 1 && -n "$ACTIVE_ROOT" ]]; then
    echo "ideasos-activate: exiting before health passed; restoring previous symlink" >&2
    restore_link "$ACTIVE_ROOT" "$PREV_TARGET"
    SWAPPED=0
  fi
  if [[ -n "$CURRENT_WORK" ]]; then
    rm -rf -- "$CURRENT_WORK"
    CURRENT_WORK=""
  fi
  exit "$status"
}
trap on_exit EXIT

require_real_dir() {
  local path="$1"
  local label="$2"
  [[ -e "$path" ]] || die "missing ${label}: ${path}"
  [[ ! -L "$path" ]] || die "${label} is a symlink: ${path}"
  [[ -d "$path" ]] || die "${label} is not a directory: ${path}"
  # Group or world write would let someone swap the directory out from under us.
  local mode
  mode=$(stat -c '%a' -- "$path")
  local other=${mode: -1}
  local group
  group=$(printf '%s' "$mode" | rev | cut -c2 | rev)
  # Digits: write bit is 2, 3, 6, or 7.
  case "$group" in
    2|3|6|7) die "${label} is group-writable: ${path}" ;;
  esac
  case "$other" in
    2|3|6|7) die "${label} is world-writable: ${path}" ;;
  esac
}

release_basename() {
  local root="$1"
  local target="$2"
  [[ -n "$target" && "$target" != *$'\n'* ]] || return 1
  local path releases base
  if [[ "$target" == /* ]]; then
    path=$target
  else
    path="${root}/${target}"
  fi
  path=$(readlink -f -- "$path") || return 1
  releases=$(readlink -f -- "${root}/releases")
  base=$(basename -- "$path")
  [[ "$(dirname -- "$path")" == "$releases" ]] || return 1
  [[ "$base" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  printf '%s\n' "$base"
}

read_previous_file() {
  local root="$1"
  local file="${root}/.previous-release"
  [[ -f "$file" && ! -L "$file" ]] || return 0
  local line
  IFS= read -r line < "$file" || true
  printf '%s\n' "$line"
}

write_previous_file() {
  local root="$1"
  local prev="$2"
  [[ -n "$prev" ]] || return 0
  [[ "$prev" != *$'\n'* ]] || die "previous target contains a newline"
  local tmp="${root}/.previous-release.new"
  if [[ -L "$tmp" || -e "$tmp" ]]; then
    [[ -L "$tmp" || -f "$tmp" ]] || die "cannot replace ${tmp}"
    rm -f -- "$tmp"
  fi
  printf '%s\n' "$prev" > "$tmp"
  chmod 644 -- "$tmp"
  mv -f -- "$tmp" "${root}/.previous-release"
}

safe_rm_release() {
  local root="$1"
  local name="$2"
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "refusing to remove odd release name"
  local releases dir real live live_base
  releases=$(readlink -f -- "${root}/releases")
  dir="${root}/releases/${name}"
  [[ ! -L "$dir" ]] || die "refusing to remove symlink at ${dir}"
  [[ -d "$dir" ]] || return 0
  real=$(readlink -f -- "$dir")
  [[ "$(basename -- "$real")" == "$name" ]] || die "release path mismatch for ${name}"
  [[ "$(dirname -- "$real")" == "$releases" ]] || die "release is outside releases: ${real}"
  if [[ -L "${root}/current" ]]; then
    live=$(readlink -- "${root}/current")
    live_base=$(release_basename "$root" "$live" || true)
    [[ "$live_base" != "$name" ]] || die "refusing to remove the live release ${name}"
  fi
  rm -rf -- "$real"
}

swap_link() {
  local root="$1"
  local rel="$2"
  if [[ -L "${root}/current.new" ]]; then
    rm -f -- "${root}/current.new"
  elif [[ -e "${root}/current.new" ]]; then
    die "current.new exists and is not a symlink"
  fi
  ln -s -- "$rel" "${root}/current.new"
  mv -T "${root}/current.new" "${root}/current"
  local now
  now=$(readlink -- "${root}/current")
  [[ "$now" == "$rel" ]] || die "current is ${now}, wanted ${rel}"
}

health_ok() {
  local curl_bin="$1"
  local release="$2"
  local body code
  body=$(mktemp)
  code=$("$curl_bin" \
    --resolve "ideasos.io:443:127.0.0.1" \
    --compressed --silent --show-error --max-time 20 \
    -o "$body" -w '%{http_code}' \
    "https://ideasos.io/") || { rm -f -- "$body"; return 1; }
  code=$(printf '%s' "$code" | tr -d '[:space:]')
  if [[ "$code" != "200" ]]; then
    rm -f -- "$body"
    return 1
  fi
  if ! cmp -s -- "$body" "${release}/index.html"; then
    rm -f -- "$body"
    return 1
  fi
  code=$("$curl_bin" \
    --resolve "ideasos.io:443:127.0.0.1" \
    --compressed --silent --show-error --max-time 20 \
    -o "$body" -w '%{http_code}' \
    "https://ideasos.io/index.json") || { rm -f -- "$body"; return 1; }
  code=$(printf '%s' "$code" | tr -d '[:space:]')
  if [[ "$code" != "200" ]]; then
    rm -f -- "$body"
    return 1
  fi
  if ! cmp -s -- "$body" "${release}/index.json"; then
    rm -f -- "$body"
    return 1
  fi
  rm -f -- "$body"
}

health_retry() {
  local i
  for i in 1 2 3; do
    if health_ok "$@"; then
      return 0
    fi
    if [[ "$i" -lt 3 ]]; then
      sleep 1
    fi
  done
  return 1
}

homepage_ok() {
  local curl_bin="$1"
  local code
  code=$("$curl_bin" \
    --resolve "ideasos.io:443:127.0.0.1" \
    --compressed --silent --show-error --max-time 20 \
    -o /dev/null -w '%{http_code}' \
    "https://ideasos.io/") || return 1
  code=$(printf '%s' "$code" | tr -d '[:space:]')
  [[ "$code" == "200" ]]
}

prune_releases() {
  local root="$1"
  local -a ordered=()
  local line name i=0
  local -A keep=()
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    name=${line#* }
    ordered+=("$name")
  done < <(find -P "${root}/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' | sort -nr)
  for name in "${ordered[@]}"; do
    i=$((i + 1))
    if [[ "$i" -le 5 ]]; then
      keep["$name"]=1
    fi
  done
  local cur="" prev=""
  if [[ -L "${root}/current" ]]; then
    cur=$(release_basename "$root" "$(readlink -- "${root}/current")" || true)
  fi
  prev=$(release_basename "$root" "$(read_previous_file "$root")" || true)
  [[ -z "$cur" ]] || keep["$cur"]=1
  [[ -z "$prev" ]] || keep["$prev"]=1
  for name in "${ordered[@]}"; do
    [[ -n "${keep[$name]:-}" ]] && continue
    safe_rm_release "$root" "$name"
  done
}

# Copy the incoming tar and sidecar without following links, verify them,
# and extract a tree under dest/tree. Prints the git sha on stdout.
unpack_release() {
  local incoming="$1"
  local dest="$2"
  python3 - "$incoming" "$dest" <<'PY'
import hashlib
import os
import stat
import sys
import tarfile

incoming, dest = sys.argv[1], sys.argv[2]
MAX_FILE = 8 * 1024 * 1024
MAX_TOTAL = 32 * 1024 * 1024
MAX_MEMBERS = 200

def fail(msg):
    sys.stderr.write(f"ideasos-activate: {msg}\n")
    sys.exit(1)

def require_dir(path):
    try:
        st = os.lstat(path)
    except OSError as exc:
        fail(f"missing directory {path}: {exc.strerror}")
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        fail(f"not a real directory: {path}")
    if stat.S_IMODE(st.st_mode) & 0o022:
        fail(f"directory is group or world writable: {path}")

def copy_nofollow(src, dst):
    try:
        fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        fail(f"cannot read {src}: {exc.strerror}")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            fail(f"not a regular file: {src}")
        if st.st_nlink != 1:
            fail(f"refusing hard link: {src}")
        if st.st_size > MAX_TOTAL:
            fail(f"file too large: {src}")
        out_fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            remaining = st.st_size
            while remaining:
                chunk = os.read(fd, min(1024 * 1024, remaining))
                if not chunk:
                    fail(f"short read: {src}")
                view = chunk
                while view:
                    wrote = os.write(out_fd, view)
                    if wrote <= 0:
                        fail(f"short write: {dst}")
                    view = view[wrote:]
                remaining -= len(chunk)
            os.fsync(out_fd)
        finally:
            os.close(out_fd)
        return st
    finally:
        os.close(fd)

def member_name(name):
    if "\x00" in name or "\\" in name:
        fail(f"refusing member name: {name!r}")
    if name.startswith("/"):
        fail(f"refusing absolute member: {name}")
    if name.startswith("./"):
        name = name[2:]
    if name.endswith("/"):
        name = name[:-1]
    if not name or name == ".":
        fail("refusing empty member")
    parts = name.split("/")
    if any(part in ("", ".", "..") or part.startswith(".") for part in parts):
        fail(f"refusing member: {name}")
    if len(name) > 240 or any(len(part) > 180 for part in parts):
        fail(f"member name too long: {name}")
    return name

require_dir(incoming)
require_dir(dest)
copy_nofollow(os.path.join(incoming, "release.tar"), os.path.join(dest, "release.tar"))
copy_nofollow(os.path.join(incoming, "release.tar.sha256"), os.path.join(dest, "release.tar.sha256"))

raw = open(os.path.join(dest, "release.tar.sha256"), "rb").read()
if not raw.endswith(b"\n") or raw.endswith(b"\n\n"):
    fail("sha256 sidecar must be exactly two lines")
lines = raw[:-1].split(b"\n")
if len(lines) != 2:
    fail("sha256 sidecar must be exactly two lines")
digest, gitsha = lines
hexdigits = b"0123456789abcdef"
if len(digest) != 64 or any(c not in hexdigits for c in digest):
    fail("sha256 sidecar digest is not 64 lowercase hex chars")
if len(gitsha) != 40 or any(c not in hexdigits for c in gitsha):
    fail("sha256 sidecar git sha is not 40 lowercase hex chars")

hasher = hashlib.sha256()
with open(os.path.join(dest, "release.tar"), "rb") as handle:
    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
        hasher.update(chunk)
if hasher.hexdigest().encode() != digest:
    fail("release.tar sha256 does not match the sidecar")

tar_path = os.path.join(dest, "release.tar")
try:
    tf = tarfile.open(tar_path, "r:")
except tarfile.TarError as exc:
    fail(f"not an uncompressed tar: {exc}")

try:
    members = tf.getmembers()
    if not members:
        fail("tar is empty")
    if len(members) > MAX_MEMBERS:
        fail(f"too many tar members ({len(members)})")
    seen = set()
    planned = []
    total = 0
    for member in members:
        if member.issym() or member.islnk():
            fail(f"refusing link member: {member.name}")
        if not (member.isdir() or member.isfile()):
            fail(f"refusing special member: {member.name}")
        if member.linkname:
            fail(f"refusing member with a link target: {member.name}")
        name = member_name(member.name)
        if name in seen:
            fail(f"duplicate member: {name}")
        seen.add(name)
        if member.isfile():
            if member.size > MAX_FILE:
                fail(f"member too large: {name}")
            total += member.size
            if total > MAX_TOTAL:
                fail("tar expands past the size limit")
        planned.append((member, name))
    if "index.html" not in seen or "index.json" not in seen:
        fail("tar is missing index.html or index.json")

    tree = os.path.join(dest, "tree")
    os.mkdir(tree, 0o700)
    dest_real = os.path.realpath(tree)
    for member, name in planned:
        target = dest_real
        for part in name.split("/"):
            target = os.path.join(target, part)
        real = os.path.realpath(target)
        if real != dest_real and not real.startswith(dest_real + os.sep):
            fail(f"member escapes the release dir: {name}")
        if member.isdir():
            os.makedirs(real, mode=0o755, exist_ok=True)
            continue
        os.makedirs(os.path.dirname(real), mode=0o755, exist_ok=True)
        src = tf.extractfile(member)
        if src is None:
            fail(f"missing file body: {name}")
        fd = os.open(real, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
        try:
            remaining = member.size
            while remaining:
                chunk = src.read(min(1024 * 1024, remaining))
                if not chunk:
                    fail(f"short read: {name}")
                view = chunk
                while view:
                    wrote = os.write(fd, view)
                    if wrote <= 0:
                        fail(f"short write: {name}")
                    view = view[wrote:]
                remaining -= len(chunk)
        finally:
            os.close(fd)

    for dirpath, dirnames, filenames in os.walk(tree, followlinks=False):
        for entry in dirnames + filenames:
            path = os.path.join(dirpath, entry)
            if os.path.islink(path):
                fail(f"symlink in extracted tree: {path}")

    sha_path = os.path.join(tree, ".deploy-sha")
    fd = os.open(sha_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    try:
        os.write(fd, gitsha + b"\n")
        os.fsync(fd)
    finally:
        os.close(fd)

    for required in ("index.html", "index.json"):
        path = os.path.join(tree, required)
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or st.st_size == 0 or stat.S_ISLNK(st.st_mode):
            fail(f"required file is empty or not a regular file: {required}")
finally:
    tf.close()

sys.stdout.write(gitsha.decode("ascii") + "\n")
PY
}

activate_body() {
  local root="$1"
  local curl_bin="$2"
  local work gitsha stamp name rel final now

  SWAPPED=0
  SUCCESS=0
  ACTIVE_ROOT=$root
  PREV_TARGET=""

  [[ "$(id -u)" -eq 0 ]] || die "must run as root"
  [[ -x "$curl_bin" ]] || die "missing curl: ${curl_bin}"
  getent passwd www-data >/dev/null || die "www-data user is missing"
  getent group www-data >/dev/null || die "www-data group is missing"
  require_real_dir "$root" "site root"
  require_real_dir "${root}/releases" "releases"
  require_real_dir "${root}/incoming" "incoming"
  [[ -L "${root}/current" || ! -e "${root}/current" ]] || die "current exists and is not a symlink"

  umask 077
  work=$(mktemp -d /var/tmp/ideasos-activate.XXXXXX)
  chmod 700 "$work"
  CURRENT_WORK=$work

  local lock="${root}/.activate.lock"
  [[ ! -L "$lock" ]] || die "lock file is a symlink"
  local lockfd
  exec {lockfd}>"$lock"
  if ! flock -w 180 "$lockfd"; then
    die "could not lock ${lock}"
  fi

  if ! gitsha=$(unpack_release "${root}/incoming" "$work"); then
    exit 1
  fi
  [[ "$gitsha" =~ ^[0-9a-f]{40}$ ]] || die "unpack did not return a git sha"

  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  name="${stamp}-${gitsha}"
  rel="releases/${name}"
  final="${root}/releases/${name}"
  [[ "$name" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{40}$ ]] || die "bad release name"
  [[ ! -e "$final" && ! -L "$final" ]] || die "release path already exists: ${final}"
  [[ -d "${work}/tree" && ! -L "${work}/tree" ]] || die "unpack did not produce a tree"

  mv -- "${work}/tree" "$final"
  chown -RP www-data:www-data -- "$final"
  find -P "$final" -type d -exec chmod 755 {} +
  find -P "$final" -type f -exec chmod 644 {} +
  local linked
  linked=$(find -P "$final" -type l -print -quit || true)
  [[ -z "$linked" ]] || die "symlink in release: ${linked}"
  [[ "$(stat -c '%U:%G' -- "${final}/index.html")" == "www-data:www-data" ]] || die "index.html owner was not set"
  [[ "$(stat -c '%a' -- "${final}/index.html")" == "644" ]] || die "index.html mode was not 644"
  [[ "$(stat -c '%a' -- "$final")" == "755" ]] || die "release directory mode was not 755"
  [[ "$(tr -d '[:space:]' < "${final}/.deploy-sha")" == "$gitsha" ]] || die ".deploy-sha does not match the git sha"

  if [[ -L "${root}/current" ]]; then
    PREV_TARGET=$(readlink -- "${root}/current")
    [[ "$PREV_TARGET" != *$'\n'* ]] || die "current target contains a newline"
  else
    PREV_TARGET=""
  fi

  swap_link "$root" "$rel"
  SWAPPED=1
  now=$(readlink -- "${root}/current")
  [[ "$now" == "$rel" ]] || die "current is not the relative link ${rel}"

  if ! health_retry "$curl_bin" "$final"; then
    restore_link "$root" "$PREV_TARGET" || die "rollback failed"
    SWAPPED=0
    safe_rm_release "$root" "$name" || true
    if [[ -n "$PREV_TARGET" ]]; then
      homepage_ok "$curl_bin" || echo "ideasos-activate: rolled back, but the previous tree did not return HTTP 200" >&2
    fi
    die "health check failed; rolled back to ${PREV_TARGET:-nothing}"
  fi

  # The new tree is live. Later failures must not point current backwards.
  SUCCESS=1
  SWAPPED=0
  write_previous_file "$root" "$PREV_TARGET"
  prune_releases "$root"

  rm -rf -- "$work"
  CURRENT_WORK=""
  flock -u "$lockfd" || true
  eval "exec ${lockfd}>&-"
  echo "ideasos-activate: activated ${rel} sha=${gitsha} previous=${PREV_TARGET:-"-"}" >&2
}

# Production paths are literals. Nothing in the environment selects them.
production() {
  activate_body /var/www/ideasos.io /usr/bin/curl
}

write_curl_stub() {
  local path="$1"
  local root="$2"
  cat > "$path" <<EOF
#!/usr/bin/env python3
import pathlib
import sys
from urllib.parse import urlparse

ROOT = pathlib.Path(${root@Q})
args = sys.argv[1:]
out = None
fmt = None
url = None
resolve = None
i = 0
while i < len(args):
    arg = args[i]
    if arg == "--resolve":
        resolve = args[i + 1]
        i += 2
        continue
    if arg in {"--compressed", "--silent", "--show-error"}:
        i += 1
        continue
    if arg in {"--max-time", "-o", "-w"}:
        value = args[i + 1]
        if arg == "-o":
            out = value
        elif arg == "-w":
            fmt = value
        i += 2
        continue
    if arg.startswith("https://"):
        url = arg
        i += 1
        continue
    sys.stderr.write(f"curl stub: unexpected {arg}\\n")
    sys.exit(2)
if resolve != "ideasos.io:443:127.0.0.1":
    sys.stderr.write(f"curl stub: resolve {resolve!r}\\n")
    sys.exit(2)
if url is None:
    sys.stderr.write("curl stub: missing url\\n")
    sys.exit(2)
with (ROOT / "curl.log").open("a", encoding="utf-8") as log:
    log.write(resolve + " " + url + "\\n")
if (ROOT / "curl-fail").exists():
    sys.exit(1)
parsed = urlparse(url)
rel = parsed.path
if (ROOT / "curl-mismatch").exists():
    body = b"MISMATCH\\n"
elif rel in ("", "/"):
    body = (ROOT / "current" / "index.html").read_bytes()
elif rel == "/index.json":
    body = (ROOT / "current" / "index.json").read_bytes()
else:
    sys.stderr.write(f"curl stub: unexpected path {rel}\\n")
    sys.exit(22)
if out and out != "/dev/null":
    pathlib.Path(out).write_bytes(body)
if fmt is not None and "%{http_code}" in fmt:
    sys.stdout.write(fmt.replace("%{http_code}", "200"))
    sys.exit(0)
if not out or out == "/dev/null":
    sys.stdout.buffer.write(body)
EOF
  chmod 755 "$path"
}

write_tar_bytes() {
  local dest="$1"
  local sha="$2"
  python3 - "$dest" "$sha" <<'PY'
import hashlib
import io
import os
import sys
import tarfile

dest, gitsha = sys.argv[1], sys.argv[2]
html = b"<!doctype html><title>new</title>\n"
index = b'{"site":"ideasos"}\n'
buf = io.BytesIO()
with tarfile.open(fileobj=buf, mode="w") as tf:
    for name, data in (("index.html", html), ("index.json", index)):
        info = tarfile.TarInfo(name)
        info.size = len(data)
        tf.addfile(info, io.BytesIO(data))
raw = buf.getvalue()
tar_path = os.path.join(dest, "release.tar")
with open(tar_path, "wb") as handle:
    handle.write(raw)
digest = hashlib.sha256(raw).hexdigest()
with open(os.path.join(dest, "release.tar.sha256"), "w", encoding="ascii") as handle:
    handle.write(digest + "\n" + gitsha + "\n")
PY
}

assert_unchanged() {
  local root="$1"
  local expected="$2"
  local extra
  [[ "$(readlink -- "${root}/current")" == "$expected" ]] || die "current moved: $(readlink -- "${root}/current" || true)"
  extra=$(find "${root}/releases" -mindepth 1 -maxdepth 1 -type d ! -name legacy -printf '%f\n' || true)
  [[ -z "$extra" ]] || die "unexpected release left behind: ${extra}"
}

self_test() {
  local fixture
  fixture=$(mktemp -d /var/tmp/ideasos-selftest.XXXXXX)
  echo "ideasos-activate: self-test dir ${fixture}" >&2
  self_test_body "$fixture"
  rm -rf -- "$fixture"
  echo "ideasos-activate self-test ok (script=${SCRIPT_NAME})" >&2
}

self_test_body() {
  local fixture="$1"
  local sha="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  local root="${fixture}/www"
  local curl_bin="${fixture}/curl"
  mkdir -p "${root}/releases/legacy" "${root}/incoming"
  chmod 755 "$root" "${root}/releases" "${root}/releases/legacy"
  chmod 700 "${root}/incoming"
  printf '<html>old</html>\n' > "${root}/releases/legacy/index.html"
  printf '{}\n' > "${root}/releases/legacy/index.json"
  ln -s releases/legacy "${root}/current"
  write_curl_stub "$curl_bin" "$root"

  # Environment must not retarget production paths.
  local evil="/tmp/evil-ideasos-site"
  rm -rf -- "$evil"
  SITE="$evil" IDEASOS_ROOT="$evil" \
    write_tar_bytes "${root}/incoming" "$sha"
  SITE="$evil" IDEASOS_ROOT="$evil" \
    activate_body "$root" "$curl_bin"
  [[ ! -e "$evil" ]] || die "environment overrode the site root"
  local now
  now=$(readlink -- "${root}/current")
  [[ "$now" =~ ^releases/[0-9]{8}T[0-9]{6}Z-${sha}$ ]] || die "link was not relative: ${now}"
  local release="${root}/${now}"
  [[ "$(tr -d '[:space:]' < "${release}/.deploy-sha")" == "$sha" ]] || die ".deploy-sha mismatch"
  [[ "$(stat -c '%U:%G' -- "${release}/index.html")" == "www-data:www-data" ]] || die "owner mismatch"
  [[ "$(stat -c '%a' -- "${release}/index.html")" == "644" ]] || die "file mode mismatch"
  [[ "$(stat -c '%a' -- "${release}")" == "755" ]] || die "dir mode mismatch"
  [[ -f "${root}/releases/legacy/index.html" ]] || die "previous release was removed"
  [[ "$(tr -d '[:space:]' < "${root}/.previous-release")" == "releases/legacy" ]] || die "previous file mismatch"
  grep -F -q "ideasos.io:443:127.0.0.1 https://ideasos.io/" "${root}/curl.log" || die "homepage was not resolved locally"
  grep -F -q "ideasos.io:443:127.0.0.1 https://ideasos.io/index.json" "${root}/curl.log" || die "index.json was not resolved locally"
  cmp -s "${release}/index.html" <(printf '<!doctype html><title>new</title>\n') || die "index.html bytes mismatch"

  # Prune keeps five newest plus an older previous target, and does not follow symlinks.
  local prune="${fixture}/prune"
  local i
  mkdir -p "${prune}/releases" "${prune}/incoming"
  chmod 755 "$prune" "${prune}/releases"
  chmod 700 "${prune}/incoming"
  for i in 1 2 3 4 5 6 7 8; do
    mkdir -p "${prune}/releases/old${i}"
    printf '%s\n' "$i" > "${prune}/releases/old${i}/marker"
    touch -d "2020-01-$(printf '%02d' "$i") 00:00:00 UTC" "${prune}/releases/old${i}"
  done
  ln -s releases/old1 "${prune}/current"
  printf 'sentinel\n' > "${prune}/sentinel"
  ln -s "${prune}/sentinel" "${prune}/releases/not-a-release"
  write_tar_bytes "${prune}/incoming" "$sha"
  : > "${prune}/curl.log"
  write_curl_stub "${fixture}/prune-curl" "$prune"
  activate_body "$prune" "${fixture}/prune-curl"
  [[ -d "${prune}/releases/old1" ]] || die "previous release was pruned"
  [[ -d "${prune}/releases/old5" && -d "${prune}/releases/old8" ]] || die "recent releases were pruned"
  [[ ! -d "${prune}/releases/old2" && ! -d "${prune}/releases/old3" && ! -d "${prune}/releases/old4" ]] || die "old releases were kept"
  [[ -f "${prune}/sentinel" && -L "${prune}/releases/not-a-release" ]] || die "prune followed a symlink"
  [[ "$(readlink -- "${prune}/current")" =~ ^releases/[0-9]{8}T[0-9]{6}Z-${sha}$ ]] || die "prune swapped away from the new release"

  # Health mismatch rolls back to the previous relative link and removes the new tree.
  local down="${fixture}/down"
  mkdir -p "${down}/releases/legacy" "${down}/incoming"
  chmod 755 "$down" "${down}/releases"
  chmod 700 "${down}/incoming"
  printf '<html>old</html>\n' > "${down}/releases/legacy/index.html"
  printf '{}\n' > "${down}/releases/legacy/index.json"
  ln -s releases/legacy "${down}/current"
  write_tar_bytes "${down}/incoming" "$sha"
  write_curl_stub "${fixture}/down-curl" "$down"
  : > "${down}/curl-mismatch"
  # activate_body exits on failure; a subshell keeps the rest of the test running.
  if ( activate_body "$down" "${fixture}/down-curl" ); then
    die "mismatched health check should fail"
  fi
  [[ "$(readlink -- "${down}/current")" == "releases/legacy" ]] || die "health failure did not roll back"
  local stray
  stray=$(find "${down}/releases" -mindepth 1 -maxdepth 1 -type d -name "*${sha}" -print -quit || true)
  [[ -z "$stray" ]] || die "failed release was left behind: ${stray}"
  [[ -f "${down}/releases/legacy/index.html" ]] || die "legacy release missing after rollback"

  # Absolute previous target is restored unchanged (pre-Actions links keep working).
  local absolute="${fixture}/absolute"
  mkdir -p "${absolute}/releases/legacy" "${absolute}/incoming"
  chmod 755 "$absolute" "${absolute}/releases"
  chmod 700 "${absolute}/incoming"
  printf '<html>old</html>\n' > "${absolute}/releases/legacy/index.html"
  printf '{}\n' > "${absolute}/releases/legacy/index.json"
  ln -s "${absolute}/releases/legacy" "${absolute}/current"
  local before
  before=$(readlink -- "${absolute}/current")
  write_tar_bytes "${absolute}/incoming" "$sha"
  write_curl_stub "${fixture}/absolute-curl" "$absolute"
  : > "${absolute}/curl-fail"
  if ( activate_body "$absolute" "${fixture}/absolute-curl" ); then
    die "failed curl should fail activate"
  fi
  [[ "$(readlink -- "${absolute}/current")" == "$before" ]] || die "absolute link was not restored"

  # Reject a symlink in incoming, a bad hash, a hard link, and unsafe members.
  local bad="${fixture}/bad"
  mkdir -p "${bad}/releases/legacy" "${bad}/incoming"
  chmod 755 "$bad" "${bad}/releases"
  chmod 700 "${bad}/incoming"
  printf '<html>old</html>\n' > "${bad}/releases/legacy/index.html"
  printf '{}\n' > "${bad}/releases/legacy/index.json"
  ln -s releases/legacy "${bad}/current"
  write_curl_stub "${fixture}/bad-curl" "$bad"
  local expect="releases/legacy"

  ln -s /etc/passwd "${bad}/incoming/release.tar"
  printf '%s\n%s\n' "$(printf '%064d' 0 | tr '0-9' 'a')" "$sha" > "${bad}/incoming/release.tar.sha256"
  if ( activate_body "$bad" "${fixture}/bad-curl" ); then
    die "symlink tar should fail"
  fi
  assert_unchanged "$bad" "$expect"
  rm -f -- "${bad}/incoming/release.tar" "${bad}/incoming/release.tar.sha256"

  write_tar_bytes "${bad}/incoming" "$sha"
  printf '%s\n%s\n' "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" "$sha" > "${bad}/incoming/release.tar.sha256"
  if ( activate_body "$bad" "${fixture}/bad-curl" ); then
    die "bad hash should fail"
  fi
  assert_unchanged "$bad" "$expect"

  rm -f -- "${bad}/incoming/release.tar"
  printf 'x\n' > "${bad}/incoming/other"
  ln "${bad}/incoming/other" "${bad}/incoming/release.tar"
  if ( activate_body "$bad" "${fixture}/bad-curl" ); then
    die "hard link should fail"
  fi
  assert_unchanged "$bad" "$expect"
  rm -f -- "${bad}/incoming/release.tar" "${bad}/incoming/other"

  write_malicious() {
    KIND="$1" python3 - "${bad}/incoming" "$sha" <<'PY'
import hashlib, io, os, sys, tarfile
incoming, gitsha = sys.argv[1], sys.argv[2]
kind = os.environ["KIND"]
buf = io.BytesIO()
with tarfile.open(fileobj=buf, mode="w") as tf:
    if kind == "symlink":
        info = tarfile.TarInfo("index.html")
        info.type = tarfile.SYMTYPE
        info.linkname = "/etc/passwd"
        tf.addfile(info)
    elif kind == "absolute":
        data = b"pwn"
        info = tarfile.TarInfo("/tmp/ideasos-pwn")
        info.size = len(data)
        tf.addfile(info, io.BytesIO(data))
    elif kind == "dotdot":
        data = b"pwn"
        info = tarfile.TarInfo("src/../../outside.txt")
        info.size = len(data)
        tf.addfile(info, io.BytesIO(data))
    else:
        raise SystemExit(kind)
raw = buf.getvalue()
with open(os.path.join(incoming, "release.tar"), "wb") as handle:
    handle.write(raw)
digest = hashlib.sha256(raw).hexdigest()
with open(os.path.join(incoming, "release.tar.sha256"), "w", encoding="ascii") as handle:
    handle.write(digest + "\n" + gitsha + "\n")
PY
  }
  write_malicious symlink
  if ( activate_body "$bad" "${fixture}/bad-curl" ); then
    die "symlink member should fail"
  fi
  assert_unchanged "$bad" "$expect"
  write_malicious absolute
  if ( activate_body "$bad" "${fixture}/bad-curl" ); then
    die "absolute member should fail"
  fi
  assert_unchanged "$bad" "$expect"
  [[ ! -e /tmp/ideasos-pwn ]] || die "absolute member was written"
  write_malicious dotdot
  if ( activate_body "$bad" "${fixture}/bad-curl" ); then
    die "dotdot member should fail"
  fi
  assert_unchanged "$bad" "$expect"
  [[ ! -e "${fixture}/outside.txt" && ! -e "${bad}/outside.txt" ]] || die "dotdot member was written"

  chmod 770 "${bad}/incoming"
  write_tar_bytes "${bad}/incoming" "$sha"
  if ( activate_body "$bad" "${fixture}/bad-curl" ); then
    die "group-writable incoming should fail"
  fi
  assert_unchanged "$bad" "$expect"
  chmod 700 "${bad}/incoming"

  # Arguments other than a bare --self-test are refused, including on the production entry.
  if ( main --self-test extra ); then
    die "extra self-test arguments should fail"
  fi
  if ( main --help ); then
    die "unknown arguments should fail"
  fi

  echo "ideasos-activate: self-test assertions passed" >&2
}

main() {
  if [[ $# -eq 0 ]]; then
    production
    return
  fi
  if [[ $# -eq 1 && "$1" == "--self-test" ]]; then
    [[ "$(id -u)" -eq 0 ]] || die "self-test must run as root"
    self_test
    return
  fi
  die "refusing arguments; production takes none"
}

main "$@"
